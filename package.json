{
  "name": "auth",
  "version": "1.0.0",
  "description": "Authentication service for pizza application",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon -L src/index.ts",
    "build": "tsc",
    "format": "prettier . --write ",
    "lint:fix": "eslint  --fix",
    "test": "jest --watch --runInBand",
    "prepare": "husky",
    "docker:build": "docker build -t auth-service:dev -f docker/dev/Dockerfile .",
    "docker:run": "docker run --rm -it -v \"%cd%\":/usr/src/app -v /usr/src/app/node_modules --env-file .env -p 8081:8081 -e NODE_ENV=development -e PORT=8081 auth-service:dev",
    "docker:dev": "pnpm docker:build && pnpm docker:run",
    "postgres:install": "docker pull postgres:17 && docker volume create pizza_auth_service",
    "postgres:run": "docker run -d --name pizza_auth_service-container -e POSTGRES_USER=root -e POSTGRES_PASSWORD=root -e POSTGRES_DB=auth -v pizza_auth_service:/var/lib/postgresql/data -p 5432:5432 postgres:17",
    "postgres:dev": "pnpm postgres:install && pnpm postgres:run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@jest/globals": "29",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "29",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "29",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.11",
    "prettier": "3.7.4",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,yaml,yml,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "http-status": "^2.1.0",
    "pg": "^8.16.3",
    "winston": "^3.19.0",
    "zod": "^4.3.4"
  },
  "packageManager": "pnpm@10.25.0+sha512.5e82639027af37cf832061bcc6d639c219634488e0f2baebe785028a793de7b525ffcd3f7ff574f5e9860654e098fe852ba8ac5dd5cefe1767d23a020a92f501"
}
